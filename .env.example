# =============================================================================
# Wolfpack Auto — environment variables
#
# This file is the source of truth for every env var the app reads.
# Mirror this list in Vercel / GitHub Actions before deploying. Anything
# below that is unset will degrade gracefully (logged + skipped) unless
# explicitly marked as a deployment blocker — see `.ai/client-context.md`.
# =============================================================================

# ── Database (PostgreSQL / Neon — DEPLOYMENT BLOCKER) ─────────────────
DATABASE_URL=postgresql://wolfpack:wolfpack@localhost:5432/wolfpack_auto
POSTGRES_USER=wolfpack
POSTGRES_PASSWORD=
POSTGRES_DB=wolfpack_auto

# Initial dealer tenant id for test-client deploys (resolves tenant context
# when no per-host mapping exists). DEPLOYMENT BLOCKER for branded preview.
DEALER_ID=

# ── Auth (NextAuth — DEPLOYMENT BLOCKERS) ─────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -hex 32
# NEXTAUTH_URL must be the canonical public URL (e.g. https://auto.<domain>.com)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Redis 7 (rate limit + cache + circuit breaker) ────────────────────
REDIS_URL=redis://localhost:6379

# ── Elasticsearch 8 (vehicle search) ──────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# ── Object storage — AWS S3 (production) ──────────────────────────────
# Required for vehicle media + AI background pipeline in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── Object storage — Cloudflare R2 (S3-compatible alternative) ────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wolfpack-auto-media
R2_PUBLIC_URL=

# ── Cloudflare Workers / Pages ───────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Application ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ── SSL / ACME (Let's Encrypt) ────────────────────────────────────────
ACME_EMAIL=ssl@wolfpackauto.com
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CHALLENGE_TYPE=http-01
# ACME_STORAGE_PATH=/etc/ssl/wolfpack

# ── Payments (Stripe) ────────────────────────────────────────────────
# STRIPE_SECRET_KEY: server-side Stripe API key (sk_live_… / sk_test_…)
# STRIPE_WEBHOOK_SECRET: rotates on Stripe side; pull into Vercel after each rotation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Communications (Resend email + Twilio SMS) ───────────────────────
# RESEND_API_KEY: server-side Resend key. Logs-and-skips when unset.
# RESEND_FROM_EMAIL: platform-level fallback FROM. Per-dealer FROM lives
#                    on dealers.from_email (migration 084) and overrides this.
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@wolfpackauto.com

# TWILIO_*: SMS dispatch. TWILIO_FROM is the verified outbound number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Vehicle background generation (fal.ai) ───────────────────────────
# Set FAL_API_KEY to enable auto-enqueue of background jobs on DMS ingest
# (lib/dms/feed-processor.ts -> lib/background-generator.ts). When unset,
# the ingest path logs + skips silently — never 500s.
FAL_API_KEY=

# ── Observability (Sentry) ───────────────────────────────────────────
# SENTRY_DSN: public ingest endpoint. SENTRY_AUTH_TOKEN gates source-map upload.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Triple-write learning fan-out (Qdrant + Neo4j) ───────────────────
# When QDRANT_URL is unset, chat uses keyword search on placeholder data.
# When NEO4J_URI is unset, graph writes degrade to a system event.
QDRANT_URL=
QDRANT_API_KEY=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ── Analytics (Plausible — privacy-friendly, no cookie banner) ──────
# Set NEXT_PUBLIC_PLAUSIBLE_DOMAIN to enable tracking (e.g. wolfpackauto.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
PLAUSIBLE_API_KEY=

# Retention window (days) used by scripts/nightly-analytics-purge.sh and the
# /api/admin/analytics/retention surface. Defaults to 365 when unset.
ANALYTICS_RETENTION_DAYS=

# ── OpenAI (embeddings — optional) ──────────────────────────────────
# If not set, uses local trigram embedding (zero cost, no API calls)
OPENAI_API_KEY=

# ── USPS Web Tools (address validation — Stream E, migration 073) ───
# Free public API. Register a USERID at:
#   https://www.usps.com/business/web-tools-apis/
# When unset, /api/address/validate returns 200 with
# { validated: false, reason: 'service_not_configured' }.
USPS_USER_ID=

# ── BYO External Credentials (migration 069) ────────────────────────
# 32-byte AES-256-GCM key (64 hex chars). Generate with:
#   openssl rand -hex 32
# This key encrypts every per-dealer credential blob stored in
# dealer_external_credentials (Carfax / AutoCheck / KBB / vAuto / MMR /
# Plaid / Edmunds). When unset in shadow mode (no DATABASE_URL), credential
# operations are no-ops. With DATABASE_URL set, missing or invalid key
# causes addCredential to return HTTP 400 with code 'key_missing' /
# 'key_invalid_length' — we never silently store plaintext.
EXTERNAL_CREDENTIAL_KEY=

# Optional: override the Edmunds public API base (development / mocking).
# Production leaves this unset; the client defaults to api.edmunds.com.
EDMUNDS_API_BASE=
# Test-only escape hatches — leave UNSET in production.
EDMUNDS_DISABLE_NETWORK=
CARFAX_API_BASE=
CARFAX_DISABLE_NETWORK=
AUTOCHECK_API_BASE=
AUTOCHECK_DISABLE_NETWORK=

# ── Cron jobs (Vercel Cron + custom triggers) ────────────────────────
# Shared bearer secret used by Vercel-cron-invoked endpoints to authenticate
# scheduled requests. Set to any random 32+ byte string.
CRON_SECRET=

# ── DMS driver (browser-driven adapter) ──────────────────────────────
# DMS_DRIVER_URL points at the headless browser driver service that fronts
# DMS portals without certified API access. DMS_DRIVER_TOKEN is the bearer
# token presented to that service. DMS_DEFAULT_VENDOR picks the adapter
# when an ingest call doesn't specify one (e.g. "mock", "tekion", ...).
DMS_DRIVER_URL=
DMS_DRIVER_TOKEN=
DMS_DEFAULT_VENDOR=mock

# ── F&I Penetration Audit (migration 074) ───────────────────────────
# hCaptcha secret for the public /audits/fi-penetration form. When unset,
# the route logs a warning and bypasses captcha (dev/test only — never
# acceptable in production).
HCAPTCHA_SECRET=
