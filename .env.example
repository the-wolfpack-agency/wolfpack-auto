# ── Database (PostgreSQL 16) ──────────────────────────────────────────
DATABASE_URL=postgresql://wolfpack:wolfpack@localhost:5432/wolfpack_auto
POSTGRES_USER=wolfpack
POSTGRES_PASSWORD=wolfpack
POSTGRES_DB=wolfpack_auto

# ── Redis 7 ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Elasticsearch 8 ──────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# ── Cloudflare R2 (S3-compatible media storage) ─────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wolfpack-auto-media
R2_PUBLIC_URL=

# ── Cloudflare Workers / Pages ───────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Application ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ── SSL / ACME (Let's Encrypt) ────────────────────────────────────────
ACME_EMAIL=ssl@wolfpackauto.com
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CHALLENGE_TYPE=http-01
# ACME_STORAGE_PATH=/etc/ssl/wolfpack

# ── Auth (future) ────────────────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
