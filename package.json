{
  "name": "wolfpack-auto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "jest --no-coverage",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:shadow": "bash scripts/shadow-test.sh",
    "predeploy": "bash scripts/predeploy-gate.sh",
    "predeploy:quick": "bash scripts/predeploy-gate.sh --quick",
    "test:predeploy": "npx playwright test --config=playwright.predeploy.config.ts",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.e2e.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:migrate && npm run db:seed",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "audit:deps": "bash scripts/audit-deps.sh",
    "test:migrations": "bash scripts/test-migrations.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@elastic/elasticsearch": "^8.13.0",
    "@sentry/nextjs": "^10.46.0",
    "@types/qrcode": "^1.5.6",
    "acme-client": "^5.4.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.4.1",
    "next": "^15.3.0",
    "next-auth": "^4.24.13",
    "otpauth": "^9.5.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "^6.9.4",
    "sharp": "^0.33.4",
    "stripe": "^21.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.0",
    "jest": "^30.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
