{
  "name": "wolfpack-auto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "openapi": "tsx scripts/generate-openapi.ts",
    "build": "npm run openapi && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "jest --no-coverage",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:shadow": "bash scripts/shadow-test.sh",
    "nightly:safety-check": "bash scripts/nightly-safety-net-check.sh",
    "nightly:pentest": "bash scripts/nightly-pentest.sh",
    "nightly:client-test": "bash scripts/nightly-client-test.sh",
    "nightly:load-test": "bash scripts/nightly-load-test.sh",
    "agenticqa:scan": "bash scripts/run-agenticqa-pipeline.sh",
    "validate": "bash scripts/validate-platform-integrity.sh",
    "validate:quick": "bash scripts/validate-platform-integrity.sh --quick",
    "predeploy": "bash scripts/predeploy-gate.sh",
    "predeploy:quick": "bash scripts/predeploy-gate.sh --quick",
    "test:canary": "npx playwright test --config=playwright.canary.config.ts",
    "canary": "bash scripts/canary-post-deploy.sh",
    "canary:quick": "bash scripts/canary-post-deploy.sh --quick",
    "canary:rollback": "bash scripts/canary-post-deploy.sh --rollback",
    "test:predeploy": "npx playwright test --config=playwright.predeploy.config.ts",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.e2e.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:migrate && npm run db:seed",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "audit:deps": "bash scripts/audit-deps.sh",
    "test:migrations": "bash scripts/test-migrations.sh",
    "test:fast": "playwright test --project=chromium tests/e2e/onboarding-flow.spec.ts tests/e2e/lead-flow-e2e.spec.ts tests/e2e/admin-api-200.spec.ts tests/e2e/security-hardening.spec.ts tests/smoke.spec.ts",
    "test:full": "playwright test --project=chromium --reporter=list",
    "test:all": "jest --no-coverage && playwright test --project=chromium --reporter=list",
    "launch": "node scripts/launch.mjs",
    "launch:check": "node scripts/launch.mjs --check-only",
    "verify": "bash scripts/verify.sh",
    "test:e2e:smoke": "playwright test --config=playwright.verify.config.ts",
    "generate:sample-fi-audit": "tsx scripts/generate-sample-fi-audit.ts",
    "generate:sample-website-audit": "tsx scripts/generate-sample-website-audit.ts"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "fast-xml-parser": "^5.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@elastic/elasticsearch": "^8.13.0",
    "@sentry/nextjs": "^10.46.0",
    "@types/qrcode": "^1.5.6",
    "acme-client": "^5.4.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.4.1",
    "next": "^15.5.18",
    "next-auth": "^4.24.13",
    "otpauth": "^9.5.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^19.2.6",
    "resend": "^6.9.4",
    "sharp": "^0.33.4",
    "stripe": "^21.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
